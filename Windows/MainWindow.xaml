<Window x:Class="GitNebula.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="GitNebula" Width="900" Height="720" MinWidth="700" MinHeight="500" Background="#090D1D" Foreground="#E9EAFA" WindowStartupLocation="CenterScreen">
  <Grid>
    <Grid IsHitTestVisible="False">
      <Rectangle><Rectangle.Fill><RadialGradientBrush Center="0.95,0" GradientOrigin="0.95,0" RadiusX="1" RadiusY="1"><GradientStop Color="#64324B85"/><GradientStop Color="#00090D1D" Offset="1"/></RadialGradientBrush></Rectangle.Fill></Rectangle>
      <Rectangle><Rectangle.Fill><RadialGradientBrush Center="0,1" GradientOrigin="0,1" RadiusX="0.8" RadiusY="0.9"><GradientStop Color="#50177B9B"/><GradientStop Color="#00090D1D" Offset="1"/></RadialGradientBrush></Rectangle.Fill></Rectangle>
      <Canvas x:Name="Stars" ClipToBounds="True" SizeChanged="Stars_SizeChanged"/>
    </Grid>
    <DockPanel Margin="24" x:Name="Workspace">
      <StackPanel DockPanel.Dock="Top">
        <DockPanel Margin="0,0,0,22"><TextBlock Text="✧ GitNebula" FontSize="24" FontWeight="Bold" Foreground="#B39DFF"/><TextBlock Text="YOUR CODE, IN ORBIT" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#9CA8C7"/></DockPanel>
        <TextBlock x:Name="Heading" FontSize="28" FontWeight="Bold"/>
        <TextBlock x:Name="Hint" Foreground="#9CA8C7" TextWrapping="Wrap" Margin="0,8,0,12"/>
        <TextBlock x:Name="Location" Text="リポジトリを選択してください。" TextWrapping="Wrap"/>
        <WrapPanel Margin="0,8,0,8"><Button x:Name="OpenButton" Content="フォルダを選択" Click="Open_Click"/><Button x:Name="RefreshButton" Content="更新" Click="Refresh_Click"/></WrapPanel>
      </StackPanel>
      <StackPanel DockPanel.Dock="Bottom">
        <Border x:Name="ConflictPanel" Style="{StaticResource Panel}">
          <StackPanel><TextBlock Text="マージの解決と完了" Foreground="#FFBE90"/>
            <ComboBox x:Name="ConflictChoice" Margin="0,8"/>
            <WrapPanel><Button Content="競合を編集" Click="EditConflict_Click"/><Button Content="外部で解決済み" Click="MarkResolved_Click"/><Button Content="マージ完了" Click="FinishMerge_Click"/><Button Content="マージ中止" Click="AbortMerge_Click"/></WrapPanel>
          </StackPanel>
        </Border>
        <StackPanel x:Name="CommitPanel" Margin="0,12,0,0">
          <TextBlock Text="コミットメッセージ" FontWeight="SemiBold"/>
          <TextBox x:Name="Message" Margin="0,8" ToolTip="変更内容を短く説明してください" AutomationProperties.Name="コミットメッセージ" TextChanged="Message_Changed"/>
          <DockPanel><TextBlock x:Name="SelectionCount" Foreground="#9CA8C7" VerticalAlignment="Center"/><Button x:Name="CommitButton" Content="コミット" Click="Commit_Click" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right"/></DockPanel>
        </StackPanel>
        <ProgressBar x:Name="Progress" IsIndeterminate="True" Height="3" Margin="0,12,0,0"/>
        <ScrollViewer MaxHeight="110" VerticalScrollBarVisibility="Auto" Margin="0,12"><TextBlock x:Name="Status" Text="準備完了" TextWrapping="Wrap" Foreground="#9CA8C7"/></ScrollViewer>
        <DockPanel><ComboBox x:Name="OtherActions" Width="240" HorizontalAlignment="Left" SelectionChanged="OtherAction_Changed"/><Button Content="閉じる" Click="Close_Click" HorizontalAlignment="Right" IsCancel="True"/></DockPanel>
      </StackPanel>
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <UniformGrid Grid.Row="1" x:Name="Launcher" Columns="2" VerticalAlignment="Top"/>
        <StackPanel x:Name="TaskPanel">
          <Border x:Name="RemotePanel" Style="{StaticResource Panel}"><StackPanel><TextBlock Text="リモート"/><ComboBox x:Name="RemoteChoice" Margin="0,10"/><TextBlock x:Name="RemoteNotice" Text="リモートが未設定です。取得元がある場合は Clone から始めてください。" TextWrapping="Wrap" Foreground="#FFBE90"/><Button x:Name="ExecuteButton" Click="Execute_Click" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left"/></StackPanel></Border>
          <StackPanel x:Name="BranchPanel"><TextBlock Text="切り替え先"/><ComboBox x:Name="BranchChoice" Margin="0,8" SelectionChanged="Branch_Changed"/><Button x:Name="SwitchButton" Content="選択したブランチに切り替え" Click="Switch_Click" HorizontalAlignment="Left"/>
            <WrapPanel x:Name="AdvancedBranches"><Button Content="作成" Click="CreateBranch_Click"/><Button Content="名前変更" Click="RenameBranch_Click"/><Button Content="削除" Click="DeleteBranch_Click"/><Button Content="現在のブランチにマージ" Click="Merge_Click"/></WrapPanel>
          </StackPanel>
          <StackPanel x:Name="ClonePanel"><TextBlock Text="取得元 URL / パス"/><TextBox x:Name="CloneSource" Margin="0,8,0,16" AutomationProperties.Name="取得元 URL またはパス" TextChanged="Message_Changed"/><TextBlock Text="作成先（新しいフォルダ）"/><TextBox x:Name="CloneDestination" Margin="0,8" AutomationProperties.Name="Clone 作成先" TextChanged="Message_Changed"/><Button Content="親フォルダを選択…" Click="CloneParent_Click" HorizontalAlignment="Left"/><Button x:Name="CloneButton" Content="Clone" Click="Clone_Click" HorizontalAlignment="Left" Style="{StaticResource PrimaryButton}"/></StackPanel>
        </StackPanel>
        <Border Grid.Row="1" x:Name="FilePanel" Style="{StaticResource Panel}">
          <DockPanel>
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10"><TextBlock x:Name="FileCount" VerticalAlignment="Center" FontWeight="SemiBold"/><WrapPanel x:Name="SelectionButtons" HorizontalAlignment="Right"><Button Content="すべて選択" Click="SelectAll_Click"/><Button Content="選択解除" Click="SelectNone_Click"/></WrapPanel></DockPanel>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"><StackPanel x:Name="Files"/></ScrollViewer>
              <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center" Background="#30264E"/>
              <TextBox Grid.Column="2" x:Name="DiffView" IsReadOnly="True" FontFamily="Consolas" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
            </Grid>
          </DockPanel>
        </Border>
        <TextBox Grid.Row="1" x:Name="History" IsReadOnly="True" FontFamily="Consolas" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
      </Grid>
    </DockPanel>
  </Grid>
</Window>
