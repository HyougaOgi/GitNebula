<Window x:Class="GitNebula.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="GitNebula" Width="900" Height="720" MinWidth="700" MinHeight="500" Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextBrush}" WindowStartupLocation="CenterScreen">
  <Grid>
    <Grid IsHitTestVisible="False">
      <Rectangle><Rectangle.Fill><RadialGradientBrush Center="0.95,0" GradientOrigin="0.95,0" RadiusX="1" RadiusY="1"><GradientStop Color="#64324B85"/><GradientStop Color="#00090D1D" Offset="1"/></RadialGradientBrush></Rectangle.Fill></Rectangle>
      <Rectangle><Rectangle.Fill><RadialGradientBrush Center="0,1" GradientOrigin="0,1" RadiusX="0.8" RadiusY="0.9"><GradientStop Color="#50177B9B"/><GradientStop Color="#00090D1D" Offset="1"/></RadialGradientBrush></Rectangle.Fill></Rectangle>
      <Canvas x:Name="Stars" ClipToBounds="True" SizeChanged="Stars_SizeChanged"/>
    </Grid>
    <DockPanel Margin="24" x:Name="Workspace">
      <WrapPanel DockPanel.Dock="Top"><Button x:Name="BackButton" Content="戻る" Click="Back_Click"/><Button x:Name="CommitEntry" Content="Commit" Tag="commit" Click="Navigate_Click"/></WrapPanel>
      <StackPanel DockPanel.Dock="Top">
        <DockPanel Margin="0,0,0,22"><TextBlock Text="✧ GitNebula" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/><TextBlock Text="YOUR CODE, IN ORBIT" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}"/></DockPanel>
        <TextBlock x:Name="Heading" FontSize="28" FontWeight="Bold"/>
        <TextBlock x:Name="Hint" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,12"/>
        <TextBlock x:Name="Location" Text="リポジトリを選択してください。" TextWrapping="Wrap"/>
        <DockPanel x:Name="PathPanel" Margin="0,8,0,0">
          <Button DockPanel.Dock="Right" x:Name="OpenPathButton" Content="パスを開く" Click="OpenPath_Click"/>
          <TextBox x:Name="RepositoryPath" AutomationProperties.Name="リポジトリのパス" ToolTip="リポジトリのパスを入力して Enter" KeyDown="RepositoryPath_KeyDown"/>
        </DockPanel>
        <WrapPanel Margin="0,8,0,8"><Button x:Name="OpenButton" Content="フォルダを選択" Click="Open_Click"/><Button x:Name="RefreshButton" Content="更新" Click="Refresh_Click"/></WrapPanel>
      </StackPanel>
      <StackPanel DockPanel.Dock="Bottom">
        <WrapPanel x:Name="SequenceBanner"><TextBlock Text="競合または進行中の Git 操作があります。" Foreground="#FFBE90" VerticalAlignment="Center"/><Button Content="競合の解決を開く" Tag="conflicts" Click="Navigate_Click"/></WrapPanel>
        <StackPanel x:Name="CommitPanel" Margin="0,12,0,0">
          <TextBlock Text="コミットメッセージ" FontWeight="SemiBold"/>
          <TextBox x:Name="Message" Margin="0,8" ToolTip="変更内容を短く説明してください" AutomationProperties.Name="コミットメッセージ" TextChanged="Message_Changed"/>
          <DockPanel><TextBlock x:Name="SelectionCount" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/><Button x:Name="CommitButton" Content="コミット" Click="Commit_Click" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right"/></DockPanel>
        </StackPanel>
        <ProgressBar x:Name="Progress" IsIndeterminate="True" Height="3" Margin="0,12,0,0"/>
        <ScrollViewer x:Name="StatusPanel" MaxHeight="110" VerticalScrollBarVisibility="Auto" Margin="0,12"><TextBlock x:Name="Status" Text="準備完了" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}"/></ScrollViewer>
        <DockPanel><Button DockPanel.Dock="Right" x:Name="HomeButton" Content="アプリ画面" Click="Home_Click"/><ComboBox x:Name="OtherActions" Width="240" HorizontalAlignment="Left" SelectionChanged="OtherAction_Changed"/><Button x:Name="PushAfterCommitButton" Content="Push" Tag="push" Click="Navigate_Click" Visibility="Collapsed" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right"/><Button Content="閉じる" Click="Close_Click" HorizontalAlignment="Right" IsCancel="True"/></DockPanel>
      </StackPanel>
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <ScrollViewer Grid.Row="1" x:Name="HomePanel" VerticalScrollBarVisibility="Auto">
          <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,70">
            <Canvas x:Name="NebulaScene" Width="360" Height="210" HorizontalAlignment="Center" Margin="0,0,0,24" AutomationProperties.Name="星雲"/>
            <TextBlock Text="GitNebula" FontSize="38" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,24"/>
            <Button Content="詳細設定" FontSize="17" Tag="settings" Click="Navigate_Click" HorizontalAlignment="Center" Style="{StaticResource PrimaryButton}"/>
          </StackPanel>
        </ScrollViewer>
        <WrapPanel Grid.Row="1" x:Name="ManagementPanel" VerticalAlignment="Top">
          <Button Content="作業ファイルを管理" Tag="files" Click="Navigate_Click"/><Button Content="ブランチを管理" Tag="branches" Click="Navigate_Click"/><Button Content="変更をマージ" Tag="merge" Click="Navigate_Click"/><Button Content="競合の解決" Tag="conflicts" Click="Navigate_Click"/><Button Content="リモートを設定" Tag="remotes" Click="Navigate_Click"/><Button Content="コミット作成者の設定" Tag="identity" Click="Navigate_Click"/>
        </WrapPanel>
        <StackPanel Grid.Row="1" x:Name="TaskPanel" VerticalAlignment="Top">
          <Border x:Name="RemotePanel" Style="{StaticResource Panel}"><StackPanel><TextBlock Text="リモート"/><ComboBox x:Name="RemoteChoice" Margin="0,10" SelectionChanged="Remote_Changed"/><TextBlock x:Name="RemoteTarget" TextWrapping="Wrap" Margin="0,8"/><TextBlock x:Name="RemoteNotice" Text="リモートが未設定です。「リモートを設定」から送受信先を登録してください。" TextWrapping="Wrap" Foreground="#FFBE90"/><Button Content="リモートを設定" Tag="remotes" Click="Navigate_Click" HorizontalAlignment="Left"/><Button x:Name="ExecuteButton" Click="Execute_Click" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left"/></StackPanel></Border>
          <Border x:Name="RemoteResultPanel" Style="{StaticResource Panel}" Margin="0,12"><StackPanel><TextBlock x:Name="RemoteResult" TextWrapping="Wrap" FontWeight="SemiBold"/><Expander Header="Git 出力"><TextBox x:Name="RemoteOutput" IsReadOnly="True" MaxHeight="200" TextWrapping="Wrap"/></Expander></StackPanel></Border>
          <StackPanel x:Name="BranchPanel"><TextBlock Text="対象のブランチ"/><ComboBox x:Name="BranchChoice" Margin="0,8" SelectionChanged="Branch_Changed"/><TextBlock x:Name="BranchNotice" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,8"/><Button x:Name="SwitchButton" Content="選択したブランチに切り替え" Click="Switch_Click" HorizontalAlignment="Left"/>
            <WrapPanel x:Name="AdvancedBranches"><Button Content="作成" Click="CreateBranch_Click"/><Button Content="名前変更" Click="RenameBranch_Click"/><Button Content="削除" Click="DeleteBranch_Click"/><Button Content="現在のブランチにマージ" Click="Merge_Click"/></WrapPanel>
            <Button x:Name="IntegrateButton" Click="Integrate_Click" HorizontalAlignment="Left" Style="{StaticResource PrimaryButton}"/>
          </StackPanel>
          <StackPanel x:Name="ClonePanel">
            <TextBlock Text="取得元 URL / パス"/>
            <TextBox x:Name="CloneSource" Margin="0,8,0,16" AutomationProperties.Name="取得元 URL またはパス" TextChanged="Message_Changed"/>
            <TextBlock Text="保存先（親フォルダ）"/>
            <TextBox x:Name="CloneParent" Margin="0,8" AutomationProperties.Name="Clone 保存先の親フォルダ" TextChanged="Message_Changed"/>
            <TextBlock Text="この中にリポジトリ用のフォルダを作ります。既存のファイルやフォルダはそのまま残ります。" TextWrapping="Wrap"/>
            <Button Content="保存先を選択…" Click="CloneParent_Click" HorizontalAlignment="Left"/>
            <TextBlock x:Name="CloneDestination" TextWrapping="Wrap" Margin="0,8"/>
            <Button x:Name="CloneButton" Content="Clone" Click="Clone_Click" HorizontalAlignment="Left" Style="{StaticResource PrimaryButton}"/>
          </StackPanel>
        </StackPanel>
        <Border Grid.Row="1" x:Name="FilePanel" Style="{StaticResource Panel}">
          <DockPanel>
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10"><TextBlock x:Name="FileCount" VerticalAlignment="Center" FontWeight="SemiBold"/><WrapPanel x:Name="SelectionButtons" HorizontalAlignment="Right"><Button Content="すべて選択" Click="SelectAll_Click"/><Button Content="選択解除" Click="SelectNone_Click"/></WrapPanel></DockPanel>
            <StackPanel DockPanel.Dock="Top" x:Name="StageButtons" Orientation="Horizontal"><Button x:Name="StageButton" Content="ステージ（Add）" Click="Stage_Click"/><Button x:Name="UnstageButton" Content="ステージ解除" Click="Unstage_Click"/></StackPanel>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"><StackPanel x:Name="Files"/></ScrollViewer>
              <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center" Background="#30264E"/>
              <TextBox Grid.Column="2" x:Name="DiffView" IsReadOnly="True" FontFamily="Consolas" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
            </Grid>
          </DockPanel>
        </Border>
        <Grid Grid.Row="1" x:Name="HistoryPanel">
          <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <ListView x:Name="CommitList" SelectionChanged="Commit_Changed" Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextBrush}"><ListView.View><GridView><GridViewColumn Header="ID" DisplayMemberBinding="{Binding ShortId}" Width="90"/><GridViewColumn Header="コミット" DisplayMemberBinding="{Binding Subject}" Width="340"/><GridViewColumn Header="作成者" DisplayMemberBinding="{Binding Author}" Width="130"/></GridView></ListView.View></ListView>
          <StackPanel Grid.Row="1"><TextBlock x:Name="HistoryNotice" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,8"/><WrapPanel><Button x:Name="CherryPickButton" Content="この変更を取り込む（Cherry-pick）" Click="CherryPick_Click"/><Button x:Name="RevertButton" Content="このコミットを取り消す（Revert）" Click="Revert_Click"/></WrapPanel></StackPanel>
          <TextBox Grid.Row="2" x:Name="History" IsReadOnly="True" FontFamily="Consolas" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
        </Grid>
        <Grid Grid.Row="1" x:Name="GraphPanel"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="160"/></Grid.RowDefinitions><ListBox x:Name="GraphList" SelectionChanged="Graph_Changed" ScrollViewer.HorizontalScrollBarVisibility="Auto"/><Button Grid.Row="1" Content="さらに読み込む" Click="GraphMore_Click" HorizontalAlignment="Right"/><TextBox Grid.Row="2" x:Name="GraphDetails" IsReadOnly="True" FontFamily="Consolas" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/></Grid>
        <StackPanel Grid.Row="1" x:Name="StashPanel">
          <TextBlock Text="退避メモ"/><TextBox x:Name="StashMessage" Margin="0,8"/>
          <CheckBox x:Name="IncludeUntracked" Content="未追跡ファイルも退避する（無視ファイルは含めない）" IsChecked="True" Checked="StashOption_Changed" Unchecked="StashOption_Changed" Foreground="{DynamicResource TextBrush}"/>
          <TextBlock x:Name="StashNotice" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,8"/>
          <Button x:Name="SaveStashButton" Content="現在の変更を退避（Stash）" Click="SaveStash_Click" HorizontalAlignment="Left"/>
          <ListBox x:Name="StashList" DisplayMemberPath="Title" Height="150" Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextBrush}" SelectionChanged="Stash_Changed"/>
          <WrapPanel><Button x:Name="ApplyStashButton" Content="適用（Apply・退避を残す）" Click="ApplyStash_Click"/><Button x:Name="PopStashButton" Content="取り出す（Pop）" Click="PopStash_Click"/><Button x:Name="DropStashButton" Content="退避を削除（Drop）" Click="DropStash_Click"/></WrapPanel>
          <TextBox x:Name="StashPreview" IsReadOnly="True" FontFamily="Consolas" Height="150" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
        </StackPanel>
        <Border Grid.Row="1" x:Name="ConflictPanel" Style="{StaticResource Panel}" VerticalAlignment="Top">
          <StackPanel><TextBlock x:Name="SequenceNotice" TextWrapping="Wrap" Foreground="#FFBE90"/>
            <ComboBox x:Name="ConflictChoice" Margin="0,8"/>
            <WrapPanel x:Name="ConflictActions"><Button Content="競合を編集" Click="EditConflict_Click"/><Button Content="外部で解決済み" Click="MarkResolved_Click"/></WrapPanel>
            <WrapPanel><Button x:Name="FinishMergeButton" Content="マージ完了" Click="FinishMerge_Click"/><Button x:Name="AbortMergeButton" Content="マージ中止" Click="AbortMerge_Click"/><Button x:Name="ContinueButton" Content="操作を再開（Continue）" Click="Continue_Click"/><Button x:Name="AbortSequenceButton" Content="操作を中止（Abort）" Click="AbortSequence_Click"/></WrapPanel>
          </StackPanel>
        </Border>
        <StackPanel Grid.Row="1" x:Name="TagsPanel"><TextBlock Text="ローカルのタグ"/><ListBox x:Name="TagList" Height="180" Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextBrush}"/><WrapPanel><Button Content="タグを作成" Click="CreateTag_Click"/><Button Content="ローカルのタグを削除" Click="DeleteTag_Click"/><Button Content="タグを送信（Push）" Click="PushTag_Click"/></WrapPanel></StackPanel>
        <StackPanel Grid.Row="1" x:Name="RemoteSettingsPanel"><TextBlock Text="登録済みリモート"/><ListBox x:Name="RemoteList" Height="150" Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextBrush}" SelectionChanged="RemoteSetting_Changed"/><TextBlock Text="リモート名"/><TextBox x:Name="RemoteName" Text="origin" Margin="0,8"/><TextBlock Text="URL またはローカルのパス"/><TextBox x:Name="RemoteUrl" Margin="0,8"/><WrapPanel><Button Content="登録 / URL を変更" Click="SaveRemote_Click"/><Button Content="登録を削除" Click="RemoveRemote_Click"/></WrapPanel></StackPanel>
        <StackPanel Grid.Row="1" x:Name="IdentityPanel"><TextBlock Text="名前"/><TextBox x:Name="IdentityName" Margin="0,8"/><TextBlock Text="メールアドレス"/><TextBox x:Name="IdentityEmail" Margin="0,8"/><Button Content="作成者を保存" Click="SaveIdentity_Click" HorizontalAlignment="Left"/></StackPanel>
        <ScrollViewer Grid.Row="1" x:Name="SettingsPanel" VerticalScrollBarVisibility="Auto"><StackPanel>
          <TextBlock Text="表示" FontSize="18" FontWeight="Bold"/><ComboBox x:Name="ThemeChoice" SelectionChanged="Appearance_Changed" Margin="0,8"><ComboBoxItem Content="システム" Tag="system"/><ComboBoxItem Content="ライト" Tag="light"/><ComboBoxItem Content="ダーク" Tag="dark"/></ComboBox>
          <DockPanel Margin="0,8"><TextBlock Text="透明度"/><TextBlock x:Name="TransparencyValue" DockPanel.Dock="Right"/><Slider x:Name="TransparencyChoice" Minimum="0" Maximum="0.8" ValueChanged="Transparency_Changed"/></DockPanel>
          <ComboBox x:Name="LanguageChoice" SelectionChanged="Appearance_Changed" Margin="0,8,0,20"><ComboBoxItem Content="日本語" Tag="ja"/><ComboBoxItem Content="English" Tag="en"/></ComboBox>
          <CheckBox x:Name="KeepRunning" Content="閉じてもシステムトレイに常駐する" Foreground="{DynamicResource TextBrush}"/>
          <TextBlock Text="トレイアイコンをクリックするとアプリ画面を表示します。" TextWrapping="Wrap" Margin="0,12"/>
          <TextBlock Text="Git の実行ファイル（空欄なら自動検出）"/><TextBox x:Name="GitExecutable" Margin="0,8"/><TextBlock x:Name="GitDetected" TextWrapping="Wrap"/>
          <TextBlock Text="SSH 認証" FontSize="18" FontWeight="Bold" Margin="0,20,0,8"/>
          <TextBlock Text="秘密鍵（空欄なら既存の SSH 設定を使用）"/>
          <DockPanel Margin="0,8"><Button Content="選択…" DockPanel.Dock="Right" Click="ChooseSshKey_Click"/><TextBox x:Name="SshKeyPath" AutomationProperties.Name="SSH 秘密鍵" TextChanged="SshKey_Changed"/></DockPanel>
          <TextBlock Text="鍵のパスフレーズ"/><PasswordBox x:Name="SshPassphrase" Margin="0,8" Padding="8" AutomationProperties.Name="鍵のパスフレーズ"/>
          <TextBlock Text="パスフレーズは Windows 資格情報マネージャーに保存し、Clone・Fetch・Pull・Push で自動使用します。" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}"/>
          <WrapPanel Margin="0,12"><Button Content="設定を保存" Click="SaveSettings_Click"/><Button Content="保存したパスフレーズを削除" Click="ForgetSshPassphrase_Click"/></WrapPanel>
          <Button Content="GitNebula を終了" Click="Quit_Click" HorizontalAlignment="Left"/>
        </StackPanel></ScrollViewer>
      </Grid>
    </DockPanel>
  </Grid>
</Window>
