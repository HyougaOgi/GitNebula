<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <StartupObject>GitNebula.Program</StartupObject>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <Version>0.6.18</Version>
    <ApplicationIcon>Assets/GitNebula.ico</ApplicationIcon>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup><Resource Include="../Mac/Assets/GitNebula.png" Link="Assets/GitNebula.png"/><EmbeddedResource Include="Assets/GitNebula.ico" LogicalName="GitNebula.icon.ico"/></ItemGroup>
  <ItemGroup><EmbeddedResource Include="../Mac/Sources/GitNebula/Resources/en.json" LogicalName="GitNebula.en.json"/></ItemGroup>
</Project>
